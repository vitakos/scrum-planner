# Copy this file to infra/.env and adjust as needed. infra/.env is git-ignored.

# Where Mongo's data is persisted on the host so it survives
# `docker compose down` / container recreation. (Postgres uses a named Docker
# volume instead, not this folder — see infra/docker-compose.yml for why.)
#
# This project runs Docker Desktop with the WSL2 backend on Windows.
#   - Running `docker compose` from PowerShell/cmd: use the Windows-style path below.
#   - Running `docker compose` from inside a WSL shell: use the Linux-style equivalent instead:
#       DB_DATA_DIR=/mnt/c/temp/scrum-planner-data
DB_DATA_DIR=C:/temp/scrum-planner-data

POSTGRES_DB=scrum_planner
POSTGRES_USER=scrum_planner
POSTGRES_PASSWORD=scrum_planner
POSTGRES_PORT=5432

MONGO_DB=scrum_planner
MONGO_ROOT_USER=scrum_planner
MONGO_ROOT_PASSWORD=scrum_planner
MONGO_PORT=27017

# backend/core (Spring Boot API)
BACKEND_PORT=8080
# Origins allowed to call the API from a browser (comma-separated, no spaces).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gap Analysis assistant (AISC-19): minimal single-provider LLM config.
# Not the multi-provider "AI Gateway" module from the roadmap (out of scope for
# this Epic) — just enough to call one provider directly.
APP_LLM_PROVIDER=anthropic
APP_LLM_API_KEY=
APP_LLM_MODEL=claude-3-5-sonnet-20241022

# frontend (React, built and served by nginx in its container)
FRONTEND_PORT=5173
# Baked into the frontend bundle at build time — where the browser reaches the
# backend from the HOST machine, not the Docker network. Rebuild the frontend
# image (docker compose build frontend) after changing this.
VITE_API_BASE_URL=http://localhost:8080
